            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Slack Ops\",\n  \"channelType\": \"WEBHOOK\",\n  \"target\": \"https://hooks.slack.com/services/XXX/YYY/ZZZ\",\n  \"minSeverity\": \"WARNING\",\n  \"eventTypes\": \"TENANT_OFFLINE,TENANT_DEGRADED,HIGH_LATENCY\",\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/platform/alerts/channels",
            "description": "Corpo: teste/bodies/platform-alert-channel.json"
          }
        }
