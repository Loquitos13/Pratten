    {
      "name": "Orders",
      "item": [
        {
          "name": "List orders",
          "request": { "method": "GET", "url": "{{baseUrl}}/orders" }
        },
        {
          "name": "Create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set('orderId', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableId\": \"{{tableId}}\",\n  \"waiterId\": \"{{waiterId}}\",\n  \"notes\": \"Pedido via Postman\"\n}"
            },
            "url": "{{baseUrl}}/orders",
            "description": "Corpo: teste/bodies/create-order.json - corre List tables e Login WAITER antes."
          }
        },
        {
          "name": "Send to kitchen",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders/{{orderId}}/send-to-kitchen"
          }
        },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const order = pm.response.json();",
                  "  if (order.items && order.items.length) {",
                  "    pm.environment.set('orderItemId', order.items[order.items.length - 1].id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"menuItemId\": \"{{menuItemId}}\",\n  \"quantity\": 2,\n  \"notes\": \"Sem sal\"\n}"
            },
            "url": "{{baseUrl}}/orders/{{orderId}}/items",
            "description": "Corpo: teste/bodies/add-order-item.json"
          }
        },
        {
          "name": "Add payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"CASH\",\n  \"amount\": 24.00,\n  \"tip\": 2.00\n}"
            },
            "url": "{{baseUrl}}/orders/{{orderId}}/payments",
            "description": "Corpo: teste/bodies/order-payment.json"
          }
        },
        {
          "name": "Close order (PAID)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"PAID\"\n}" },
            "url": "{{baseUrl}}/orders/{{orderId}}/status"
          }
        }
      ]
