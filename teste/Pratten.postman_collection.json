{
  "info": {
    "_postman_id": "pratten-api-collection",
    "name": "Pratten API",
    "description": "Collection para testar a API Pratten. Corpos de exemplo em `teste/bodies/`. Importa também `Pratten.local.postman_environment.json`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{staffToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth (staff)",
      "item": [
        {
          "name": "Register restaurant",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantName\": \"Restaurante Teste\",\n  \"slug\": \"teste-postman\",\n  \"managerName\": \"Gestor Teste\",\n  \"email\": \"gestor@teste-postman.pt\",\n  \"password\": \"teste1234\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Corpo: teste/bodies/auth-register.json"
          }
        },
        {
          "name": "Login staff (OWNER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('staffToken', json.token);",
                  "  if (json.user) {",
                  "    pm.environment.set('tenantId', json.user.tenantId);",
                  "    pm.environment.set('waiterId', json.user.userId);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"demo\",\n  \"email\": \"ana@demo.pt\",\n  \"password\": \"demo1234\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Corpo: teste/bodies/auth-login-staff.json"
          }
        },
        {
          "name": "Login staff (WAITER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('staffToken', json.token);",
                  "  if (json.user) {",
                  "    pm.environment.set('tenantId', json.user.tenantId);",
                  "    pm.environment.set('waiterId', json.user.userId);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"demo\",\n  \"email\": \"joao@demo.pt\",\n  \"password\": \"demo1234\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Corpo: teste/bodies/auth-login-waiter.json"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Platform",
      "item": [
        {
          "name": "Login superadmin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set('platformToken', pm.response.json().token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@pratten.pt\",\n  \"password\": \"superadmin1234\"\n}"
            },
            "url": "{{baseUrl}}/platform/auth/login",
            "description": "Corpo: teste/bodies/auth-login-platform.json"
          }
        },
        {
          "name": "Me (superadmin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/platform/auth/me"
          }
        },
        {
          "name": "List tenants",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const list = pm.response.json();",
                  "  if (list.length) pm.environment.set('tenantId', list[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/platform/tenants"
          }
        },
        {
          "name": "Create tenant",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Restaurante Novo\",\n  \"slug\": \"novo-rest\",\n  \"vatNumber\": \"500000001\",\n  \"address\": \"Av. Teste, Porto\",\n  \"currency\": \"EUR\",\n  \"ownerName\": \"Owner Novo\",\n  \"ownerEmail\": \"owner@novo-rest.pt\",\n  \"ownerPassword\": \"owner12345\"\n}"
            },
            "url": "{{baseUrl}}/platform/tenants",
            "description": "Corpo: teste/bodies/platform-create-tenant.json"
          }
        },
        {
          "name": "Get tenant",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/platform/tenants/{{tenantId}}"
          }
        },
        {
          "name": "Update tenant",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supportNotes\": \"Cliente em onboarding - contacto via email.\",\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/platform/tenants/{{tenantId}}",
            "description": "Corpo: teste/bodies/platform-update-tenant.json"
          }
        },
        {
          "name": "Diagnostics",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/platform/tenants/{{tenantId}}/diagnostics"
          }
        },
        {
          "name": "Audit log",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/platform/tenants/{{tenantId}}/audit"
          }
        },
        {
          "name": "Reset staff password",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"novaPassword123\"\n}"
            },
            "url": "{{baseUrl}}/platform/tenants/{{tenantId}}/staff/{{staffId}}/reset-password",
            "description": "Corpo: teste/bodies/platform-reset-password.json"
          }
        },
        {
          "name": "Unlock staff login",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }]
            },
            "method": "POST",
            "url": "{{baseUrl}}/platform/tenants/{{tenantId}}/staff/{{staffId}}/unlock-login"
          }
        },
        {
          "name": "Start remote session (OWNER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('remoteToken', json.token);",
                  "  pm.environment.set('remoteSessionId', json.sessionId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Suporte remoto - cliente reportou mesas bloqueadas\",\n  \"durationMinutes\": 60\n}"
            },
            "url": "{{baseUrl}}/platform/tenants/{{tenantId}}/remote-session",
            "description": "Corpo: teste/bodies/platform-remote-session.json"
          }
        },
        {
          "name": "Remote session - list tables",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const list = pm.response.json();",
                  "  if (list.length) pm.environment.set('tableId', list[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{remoteToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/tables"
          }
        },
        {
          "name": "End remote session",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }]
            },
            "method": "POST",
            "url": "{{baseUrl}}/platform/tenants/{{tenantId}}/remote-session/{{remoteSessionId}}/end"
          }
        },
        {
          "name": "Dashboard",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/platform/dashboard"
          }
        },
        {
          "name": "Health overview",
          "request": {
