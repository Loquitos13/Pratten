        {
          "name": "Global audit",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/platform/audit"
          }
        },
        {
          "name": "List platform admins",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{platformToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/platform/admins"
          }
